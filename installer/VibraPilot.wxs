<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" RequiredVersion="6.0.2">
  <Package
      Name="VibraPilot"
      Manufacturer="Vib Tools"
      Version="$(var.MsiVersion)"
      UpgradeCode="5DB4BF6A-58D7-5A32-8FD4-2EA5AFABEBA2"
      Scope="perUser"
      Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of VibraPilot is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="VibToolsFolder" Name="Vib Tools">
        <Directory Id="INSTALLFOLDER" Name="VibraPilot" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="441BAB02-4A19-57D9-B325-856BA8A7C50D">
        <Shortcut
            Id="VibraPilotStartMenuShortcut"
            Name="VibraPilot"
            Description="VibraPilot browser automation desktop application"
            Target="[INSTALLFOLDER]VibraPilot.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Vib Tools\VibraPilot\Installer"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="VibraPilot" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
